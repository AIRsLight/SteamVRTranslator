<Window x:Class="SteamVRTranslator.App.Subtitles.SubtitleHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SteamVRTranslator.App"
        xmlns:loc="clr-namespace:SteamVRTranslator.App.Localization"
        xmlns:steamvr="clr-namespace:SteamVRTranslator.App.SteamVR"
        Title="{loc:Loc Key=Subtitle.Window.Title}"
        Width="720" Height="480" MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Foreground="#F4F8F6"
        FontFamily="Segoe UI Variable, Segoe UI">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#F4F8F6" />
            <Setter Property="BorderBrush" Value="#70FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="steamvr:VrPointerHover.IsHovered" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="#304DE0C1" />
                                <Setter TargetName="Shell" Property="BorderBrush" Value="#FF4DE0C1" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="#304DE0C1" />
                                <Setter TargetName="Shell" Property="BorderBrush" Value="#FF4DE0C1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="#604DE0C1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="WindowFrame" Background="#E118201D" BorderBrush="Transparent"
            BorderThickness="2" CornerRadius="20" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="66" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Background="#B81F2926" BorderBrush="#55FFFFFF"
                    BorderThickness="0,0,0,1" Padding="18,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc Key=Subtitle.Window.Title}" FontSize="16"
                                   FontWeight="SemiBold" Foreground="#F7FAF9" />
                        <TextBlock Text="{loc:Loc Key=Subtitle.Window.Experimental}" FontSize="10"
                                   Foreground="#B8C8C2" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button x:Name="ListenButton" Grid.Column="1" Style="{StaticResource ToolbarButton}"
                            Width="144" Margin="0,0,12,0" Click="ListenButton_Click"
                            ToolTip="{loc:Loc Key=Subtitle.Window.StartListening}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Path x:Name="ListenButtonIcon" Data="{x:Static local:MaterialIconPaths.Play}"
                                  Width="16" Height="16" Stretch="Uniform"
                                  Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                            <TextBlock x:Name="ListenButtonText" Text="{loc:Loc Key=Subtitle.Window.StartListening}"
                                       Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ClearButton" Grid.Column="2" Style="{StaticResource ToolbarButton}" Margin="0,0,12,0"
                            Click="ClearButton_Click" ToolTip="{loc:Loc Key=Subtitle.Window.Clear}">
                        <Path Data="{x:Static local:MaterialIconPaths.DeleteOutline}" Width="17" Height="17"
                              Stretch="Uniform" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                    </Button>
                    <Button x:Name="CloseButton" Grid.Column="3" Style="{StaticResource ToolbarButton}" Click="CloseButton_Click"
                            ToolTip="{loc:Loc Key=Subtitle.Window.Hide}">
                        <Path Data="{x:Static local:MaterialIconPaths.Close}" Width="17" Height="17"
                              Stretch="Uniform" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                    </Button>
                </Grid>
            </Border>
            <ListBox x:Name="HistoryListBox" Grid.Row="1" ItemsSource="{Binding Entries}"
                     BorderThickness="0" Background="Transparent" Padding="16,12"
                     ScrollViewer.CanContentScroll="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Hidden"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,10" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Focusable" Value="False" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#A6293430" BorderBrush="#55FFFFFF"
                                BorderThickness="1" CornerRadius="9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{Binding SpeakerBrush}" CornerRadius="8,0,0,8" />
                                <StackPanel Grid.Column="1" Margin="14,11,14,13">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{loc:Loc Key=Subtitle.Window.Speaker}" FontSize="11"
                                                   FontWeight="SemiBold" Foreground="{Binding SpeakerBrush}" />
                                        <TextBlock Text="{Binding DisplaySpeaker}" FontSize="11"
                                                   FontWeight="SemiBold" Foreground="{Binding SpeakerBrush}" Margin="3,0,0,0" />
                                        <TextBlock Text="{Binding TimeRange}" FontSize="10"
                                                   Foreground="#AFC1BA" Margin="10,1,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding SourceText}" FontSize="13" Foreground="#C7D5D0"
                                               TextWrapping="Wrap" Margin="0,7,0,0" />
                                    <TextBlock Text="{Binding TranslatedText}" FontSize="16" Foreground="#FFFFFF"
                                               TextWrapping="Wrap" Margin="0,7,0,0" />
                                    <TextBlock Text="{loc:Loc Key=Subtitle.Window.Translating}" FontSize="11"
                                               Foreground="#AFC1BA" Margin="0,7,0,0"
                                               Visibility="{Binding IsTranslating, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock Text="{Binding Error}" FontSize="11" Foreground="#FF8B8B"
                                               TextWrapping="Wrap" Margin="0,7,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</Window>
