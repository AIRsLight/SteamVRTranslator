<Window x:Class="SteamVRTranslator.App.AndroidMirror.AndroidMirrorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SteamVRTranslator.App"
        xmlns:loc="clr-namespace:SteamVRTranslator.App.Localization"
        xmlns:steamvr="clr-namespace:SteamVRTranslator.App.SteamVR"
        x:ClassModifier="internal"
        Title="Android Mirror"
        Width="400" Height="920"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="NavigationButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="82" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="8,3" />
            <Setter Property="Foreground" Value="#EAF4F1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="steamvr:VrPointerHover.IsHovered" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="#2437D7B7" />
                                <Setter TargetName="Shell" Property="BorderBrush" Value="#FF78EBD2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="#5941DABD" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="WindowFrame"
            CornerRadius="18"
            BorderThickness="2"
            BorderBrush="Transparent"
            Background="Transparent"
            SnapsToDevicePixels="True">
        <Grid x:Name="RootGrid" ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="ScreenRow" Height="*" />
                <RowDefinition x:Name="NavigationRow" Height="50" />
            </Grid.RowDefinitions>

            <Grid x:Name="ScreenHost" Background="Transparent" ClipToBounds="True">
                <Image x:Name="PhoneImage"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Stretch="Fill"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <Border x:Name="StatusPanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="330"
                        Padding="18,12"
                        CornerRadius="8"
                        Background="#D916211D">
                    <StackPanel>
                        <ProgressBar x:Name="ConnectingProgress"
                                     Height="3"
                                     IsIndeterminate="True"
                                     Foreground="#2EE58C"
                                     Background="#33463E"
                                     Margin="0,0,0,10" />
                        <TextBlock x:Name="StatusText"
                                   Text="{loc:Loc Key=AndroidMirror.Status.Initializing}"
                                   Foreground="White"
                                   FontSize="15"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="1" Background="#FF101916" BorderBrush="#30495A54" BorderThickness="0,1,0,0">
                <UniformGrid Rows="1" Columns="3" HorizontalAlignment="Center">
                    <Button x:Name="BackButton" Tag="Back" Style="{StaticResource NavigationButtonStyle}" Click="NavigationButton_Click">
                        <Path Data="{x:Static local:MaterialIconPaths.AndroidBack}" Width="22" Height="22" Stretch="Uniform" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                    </Button>
                    <Button x:Name="HomeButton" Tag="Home" Style="{StaticResource NavigationButtonStyle}" Click="NavigationButton_Click">
                        <Path Data="{x:Static local:MaterialIconPaths.CircleOutline}" Width="20" Height="20" Stretch="Uniform" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="2" />
                    </Button>
                    <Button x:Name="RecentAppsButton" Tag="RecentApps" Style="{StaticResource NavigationButtonStyle}" Click="NavigationButton_Click">
                        <Path Data="{x:Static local:MaterialIconPaths.SquareOutline}" Width="19" Height="19" Stretch="Uniform" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="2" />
                    </Button>
                </UniformGrid>
            </Border>
        </Grid>
    </Border>
</Window>
