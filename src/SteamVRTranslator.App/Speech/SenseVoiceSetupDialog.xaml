<Window x:Class="SteamVRTranslator.App.Speech.SenseVoiceSetupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:SteamVRTranslator.App"
        xmlns:loc="clr-namespace:SteamVRTranslator.App.Localization"
        Title="{loc:Loc Key=Setup.Asr.Title}"
        Width="540"
        SizeToContent="Height"
        MaxHeight="700"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#F5F6F4"
        FontFamily="Segoe UI Variable, Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#087E72" />
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#202622" />
            <Setter Property="BorderBrush" Value="#C9D0CB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="PrimaryDialogButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style x:Key="SourceOptionStyle" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D5DBD6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="OptionBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="RadioRing" Width="16" Height="16" CornerRadius="8"
                                        BorderBrush="#8C9891" BorderThickness="1.5" VerticalAlignment="Top" Margin="0,2,0,0">
                                    <Ellipse x:Name="RadioDot" Width="8" Height="8" Fill="{StaticResource AccentBrush}" Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter Grid.Column="1" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OptionBorder" Property="BorderBrush" Value="#7AA79F" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="OptionBorder" Property="Background" Value="#EDF7F5" />
                                <Setter TargetName="OptionBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="RadioRing" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="RadioDot" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer Background="#F5F6F4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28,25,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="5" Background="#E3F1EE" VerticalAlignment="Top">
                    <Path Data="{x:Static app:MaterialIconPaths.Download}" Width="18" Height="18"
                          Stretch="Uniform" Fill="{StaticResource AccentBrush}" />
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{loc:Loc Key=Setup.Asr.Heading}" FontSize="18" FontWeight="SemiBold" Foreground="#202622" />
                    <TextBlock Text="{loc:Loc Key=Setup.Asr.Description}" Margin="0,5,0,0" FontSize="11"
                               Foreground="#66706A" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Margin="0,18,0,18" Padding="14,11" Background="White"
                    BorderBrush="#D9DED9" BorderThickness="1" CornerRadius="5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{loc:Loc Key=Setup.Asr.SelectedModel}" FontWeight="SemiBold" Foreground="#202622" />
                    <TextBlock x:Name="ModelValueText" Grid.Column="1" Margin="14,0,0,0" Foreground="#202622" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Text="{loc:Loc Key=Setup.Asr.MissingAssets}" Margin="0,7,0,0"
                               FontWeight="SemiBold" Foreground="#202622" />
                    <TextBlock x:Name="MissingAssetsText" Grid.Row="1" Grid.Column="1" Margin="14,7,0,0"
                               Foreground="#9A5A00" TextWrapping="Wrap" />
                </Grid>
            </Border>

            <TextBlock Grid.Row="2" Text="{loc:Loc Key=Setup.Asr.Source}" Margin="0,0,0,9"
                       FontSize="12" FontWeight="SemiBold" Foreground="#202622" />

            <StackPanel Grid.Row="3">
                <RadioButton x:Name="OfficialSourceRadioButton" GroupName="DownloadSource" Style="{StaticResource SourceOptionStyle}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Key=Setup.Asr.Source.Official}" FontWeight="SemiBold" Foreground="#202622" />
                        <TextBlock Text="{loc:Loc Key=Setup.Asr.Source.OfficialHint}" Margin="0,3,0,0"
                                   FontSize="10" Foreground="#66706A" TextWrapping="Wrap" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="MirrorSourceRadioButton" GroupName="DownloadSource" Style="{StaticResource SourceOptionStyle}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Key=Setup.Asr.Source.Mirror}" FontWeight="SemiBold" Foreground="#202622" />
                        <TextBlock Text="{loc:Loc Key=Setup.Asr.Source.MirrorHint}" Margin="0,3,0,0"
                                   FontSize="10" Foreground="#66706A" TextWrapping="Wrap" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>

            <TextBlock Grid.Row="4" Text="{loc:Loc Key=Setup.Asr.Integrity}" Margin="0,2,0,18"
                       FontSize="10" Foreground="#66706A" TextWrapping="Wrap" />

            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource DialogButtonStyle}" Margin="0,0,8,0"
                        Content="{loc:Loc Key=Setup.Asr.Cancel}" IsCancel="True" Click="CancelButton_Click" />
                <Button x:Name="InstallButton" Style="{StaticResource PrimaryDialogButtonStyle}" IsDefault="True"
                        Click="InstallButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{x:Static app:MaterialIconPaths.Download}" Width="15" Height="15"
                              Stretch="Uniform" Fill="White" />
                        <TextBlock Text="{loc:Loc Key=Setup.Asr.InstallAndStart}" Margin="7,0,0,0" Foreground="White" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
