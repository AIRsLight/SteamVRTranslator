{
  "controller_type": "holographic_controller",
  "name": "SteamVR Translator WMR bindings",
  "description": "Left joystick translates a touched capture; grips move overlays; right stick scrolls, toggles all overlays, or closes a targeted overlay after a 0.67-second hold.",
  "bindings": {
    "/actions/global": {
      "sources": [
        { "path": "/user/hand/left/input/joystick", "mode": "button", "inputs": { "click": { "output": "/actions/global/in/toggle" } } }
      ]
    },
    "/actions/selection": {
      "sources": [
        { "path": "/user/hand/left/input/trigger", "mode": "trigger", "inputs": { "click": { "output": "/actions/selection/in/left_trigger" } } },
        { "path": "/user/hand/right/input/trigger", "mode": "trigger", "inputs": { "click": { "output": "/actions/selection/in/right_trigger" } } }
      ],
      "haptics": [
        { "output": "/actions/selection/out/left_haptic", "path": "/user/hand/left/output/haptic" },
        { "output": "/actions/selection/out/right_haptic", "path": "/user/hand/right/output/haptic" }
      ]
    },
    "/actions/results": {
      "sources": [
        { "path": "/user/hand/right/input/joystick", "mode": "joystick", "inputs": { "position": { "output": "/actions/results/in/scroll" }, "click": { "output": "/actions/results/in/toggle_visibility" } } },
        { "path": "/user/hand/left/input/grip", "mode": "button", "inputs": { "click": { "output": "/actions/results/in/left_grip" } } },
        { "path": "/user/hand/right/input/grip", "mode": "button", "inputs": { "click": { "output": "/actions/results/in/right_grip" } } },
        { "path": "/user/hand/left/input/trigger", "mode": "trigger", "inputs": { "click": { "output": "/actions/results/in/left_pointer_click" } } },
        { "path": "/user/hand/right/input/trigger", "mode": "trigger", "inputs": { "click": { "output": "/actions/results/in/right_pointer_click" } } }
      ]
    },
    "/actions/voiceinput": {
      "sources": [
        { "path": "/user/hand/right/input/application_menu", "mode": "button", "inputs": { "click": { "output": "/actions/voiceinput/in/ptt" } } }
      ]
    }
  }
}
