                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{loc:Loc Key=AndroidMirror.Device}" />
                                    <ComboBox x:Name="AndroidDeviceComboBox" Grid.Column="1" DisplayMemberPath="DisplayName" SelectionChanged="AndroidDeviceComboBox_SelectionChanged" ToolTip="{loc:Loc Key=AndroidMirror.Device.Tooltip}" />
                                    <Button x:Name="RefreshAndroidDevicesButton" Grid.Column="2" Style="{StaticResource ActionButtonStyle}" Margin="8,0,0,0" Click="RefreshAndroidDevicesButton_Click" ToolTip="{loc:Loc Key=AndroidMirror.Refresh.Tooltip}">
                                        <StackPanel Orientation="Horizontal"><Path Data="{x:Static local:MaterialIconPaths.Refresh}" Width="15" Height="15" Stretch="Uniform" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" /><TextBlock Text="{loc:Loc Key=AndroidMirror.Refresh}" Margin="7,0,0,0" /></StackPanel>
                                    </Button>
                                    <TextBlock Grid.Row="1" Style="{StaticResource FieldLabelStyle}" Text="{loc:Loc Key=AndroidMirror.Runtime}" Margin="0,12,0,0" />
                                    <TextBlock x:Name="AndroidMirrorRuntimeStatusText" Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                                    <Button x:Name="DownloadAndroidMirrorRuntimeButton" Grid.Row="1" Grid.Column="2" Style="{StaticResource ActionButtonStyle}" Margin="8,12,0,0" Click="DownloadAndroidMirrorRuntimeButton_Click">
                                        <StackPanel Orientation="Horizontal"><Path Data="{x:Static local:MaterialIconPaths.Download}" Width="15" Height="15" Stretch="Uniform" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" /><TextBlock Text="{loc:Loc Key=AndroidMirror.Download}" Margin="7,0,0,0" /></StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionStyle}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Key=AndroidMirror.Quality.Title}" FontSize="15" FontWeight="SemiBold" />
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{loc:Loc Key=AndroidMirror.MaxSize}" />
                                    <ComboBox x:Name="AndroidMirrorMaxSizeComboBox" Grid.Column="1"><ComboBoxItem Content="720p" Tag="720" /><ComboBoxItem Content="900p" Tag="900" /><ComboBoxItem Content="1080p" Tag="1080" /></ComboBox>
                                    <TextBlock Grid.Row="1" Style="{StaticResource FieldLabelStyle}" Text="{loc:Loc Key=AndroidMirror.MaxFps}" Margin="0,12,0,0" />
                                    <ComboBox x:Name="AndroidMirrorMaxFpsComboBox" Grid.Row="1" Grid.Column="1" Margin="0,12,0,0"><ComboBoxItem Content="30 FPS" Tag="30" /><ComboBoxItem Content="60 FPS" Tag="60" /><ComboBoxItem Content="90 FPS" Tag="90" /><ComboBoxItem Content="120 FPS" Tag="120" /></ComboBox>
                                    <TextBlock Grid.Row="2" Style="{StaticResource FieldLabelStyle}" Text="{loc:Loc Key=AndroidMirror.BitRate}" Margin="0,12,0,0" />
                                    <ComboBox x:Name="AndroidMirrorBitRateComboBox" Grid.Row="2" Grid.Column="1" Margin="0,12,0,0"><ComboBoxItem Content="2 Mbps" Tag="2" /><ComboBoxItem Content="4 Mbps" Tag="4" /><ComboBoxItem Content="8 Mbps" Tag="8" /><ComboBoxItem Content="12 Mbps" Tag="12" /></ComboBox>
                                    <TextBlock Grid.Row="3" Style="{StaticResource FieldLabelStyle}" Text="{loc:Loc Key=AndroidMirror.Decoder}" Margin="0,12,0,0" />
                                    <ComboBox x:Name="AndroidMirrorDecoderComboBox" Grid.Row="3" Grid.Column="1" Margin="0,12,0,0" ToolTip="{loc:Loc Key=AndroidMirror.Decoder.Tooltip}" SelectionChanged="AndroidDeviceComboBox_SelectionChanged"><ComboBoxItem Content="{loc:Loc Key=AndroidMirror.Decoder.Auto}" Tag="auto" /><ComboBoxItem Content="{loc:Loc Key=AndroidMirror.Decoder.Software}" Tag="software" /><ComboBoxItem Content="{loc:Loc Key=AndroidMirror.Decoder.D3D11}" Tag="d3d11va" /></ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="StartStopAndroidMirrorButton" Style="{StaticResource PrimaryButtonStyle}" Click="StartStopAndroidMirrorButton_Click" IsEnabled="False">
                                <StackPanel Orientation="Horizontal"><Path x:Name="AndroidMirrorStartStopIcon" Data="{x:Static local:MaterialIconPaths.Play}" Width="15" Height="15" Stretch="Uniform" Fill="White" /><TextBlock x:Name="AndroidMirrorStartStopText" Text="{loc:Loc Key=AndroidMirror.Start}" Foreground="White" Margin="7,0,0,0" /></StackPanel>
                            </Button>
                            <TextBlock x:Name="AndroidMirrorStatusText" Text="{loc:Loc Key=AndroidMirror.Status.Ready}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="14,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="520" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="DiagnosticsPage" Visibility="Collapsed" Margin="28,24">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="{loc:Loc Key=Diagnostics.Title}" FontSize="15" FontWeight="SemiBold" /><TextBlock Text="{loc:Loc Key=Diagnostics.Description}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,3,0,0" /></StackPanel>
                        <Button x:Name="OpenLogButton" Grid.Column="1" Style="{StaticResource ActionButtonStyle}" Click="OpenLogButton_Click">
                            <StackPanel Orientation="Horizontal"><Path Data="{x:Static local:MaterialIconPaths.FolderOpenOutline}" Width="15" Height="15" Stretch="Uniform" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" /><TextBlock Text="{loc:Loc Key=Diagnostics.OpenFolder}" Margin="7,0,0,0" /></StackPanel>
                        </Button>
                    </Grid>
                    <TextBox x:Name="LogTextBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="11" Background="#1F2329" Foreground="#E1E5EC" BorderThickness="0" Padding="12" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
