<Window x:Class="SteamVRTranslator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SteamVRTranslator.App"
        xmlns:loc="clr-namespace:SteamVRTranslator.App.Localization"
        Title="SteamVR Translator" Width="1120" Height="760"
        MinWidth="920" MinHeight="640"
        Background="#F4F7F8" FontFamily="Segoe UI Variable, Segoe UI"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#3D73E6" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#2F5FC4" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#E8EEFF" />
        <SolidColorBrush x:Key="CoralBrush" Color="#EF6B5B" />
        <SolidColorBrush x:Key="CoralSoftBrush" Color="#FDE9E5" />
        <SolidColorBrush x:Key="SkyBrush" Color="#3E8DCE" />
        <SolidColorBrush x:Key="SkySoftBrush" Color="#E7F2FB" />
        <SolidColorBrush x:Key="AmberBrush" Color="#E6A23C" />
        <SolidColorBrush x:Key="AmberSoftBrush" Color="#FFF2D8" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="MutedSurfaceBrush" Color="#F5F8FA" />
        <SolidColorBrush x:Key="BorderBrush" Color="#D8E0E5" />
        <SolidColorBrush x:Key="TextBrush" Color="#252B33" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#68727D" />
        <SolidColorBrush x:Key="NavigationIconBrush" Color="#8FB5FF" />
        <SolidColorBrush x:Key="ExperimentalNavigationIconBrush" Color="#FF9E7A" />
        <local:ProviderActiveVisibilityConverter x:Key="ProviderActiveVisibilityConverter" />

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#C7D2D8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource SkySoftBrush}" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="#9FC5E3" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#D7EAF8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}" />

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#DFE3EA" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#3C424B" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#C7D2D8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="SelectionBrush" Value="#B8CAF8" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#9DB9C7" />
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="InputBorder" Property="Background" Value="{StaticResource MutedSurfaceBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputBorder" Property="Background" Value="{StaticResource MutedSurfaceBrush}" />
                                <Setter Property="Foreground" Value="#9BA8A3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PromptEditorStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="168" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#C7D2D8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="PasswordBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="PasswordBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PasswordBorder" Property="BorderBrush" Value="#9DB9C7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PasswordBorder" Property="Background" Value="{StaticResource MutedSurfaceBrush}" />
                                <Setter Property="Opacity" Value="0.58" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                CornerRadius="4" Margin="2,1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding ContentStringFormat}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SkySoftBrush}" />
                                <Setter Property="Foreground" Value="#246B9D" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter Property="Foreground" Value="#2F5FC4" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="10,0,34,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#C7D2D8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MaxDropDownHeight" Value="320" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="34" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ComboBorder" Grid.ColumnSpan="2"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6" />
                            <ToggleButton x:Name="DropDownToggle" Grid.ColumnSpan="2"
                                          Background="Transparent" BorderThickness="0"
                                          ClickMode="Press" Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="SelectionContent" Grid.Column="0"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                            <TextBox x:Name="PART_EditableTextBox" Grid.Column="0"
                                     Style="{x:Null}" Visibility="Collapsed"
                                     Margin="1" Padding="9,0"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{TemplateBinding Foreground}"
                                     FontFamily="{TemplateBinding FontFamily}"
                                     FontSize="{TemplateBinding FontSize}"
                                     VerticalContentAlignment="Center"
                                     IsReadOnly="{TemplateBinding IsReadOnly}" />
                            <Path Grid.Column="1" Data="{x:Static local:MaterialIconPaths.ChevronDown}"
                                  Width="13" Height="13" Stretch="Uniform"
                                  Fill="{StaticResource MutedTextBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  IsHitTestVisible="False" />
                            <Popup x:Name="PART_Popup" Grid.ColumnSpan="2"
                                   AllowsTransparency="True" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, ElementName=ComboBorder}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0,4,0,0" Padding="2"
                                        Background="White" BorderBrush="#B8C7CF"
                                        BorderThickness="1" CornerRadius="7">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.17" Color="#39505C" />
                                    </Border.Effect>
                                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="SelectionContent" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                                <Setter TargetName="DropDownToggle" Property="Grid.Column" Value="1" />
                                <Setter TargetName="DropDownToggle" Property="Grid.ColumnSpan" Value="1" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#9DB9C7" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="ComboBorder" Property="Background" Value="#FBFFFE" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ComboBorder" Property="Background" Value="{StaticResource MutedSurfaceBrush}" />
                                <Setter Property="Opacity" Value="0.56" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent" MinHeight="32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" Margin="0,0,12,0"
                                              VerticalAlignment="Center" RecognizesAccessKey="True" />
                            <Border x:Name="SwitchTrack" Grid.Column="1" Width="34" Height="20"
                                    CornerRadius="10" Background="#B9C5C1" VerticalAlignment="Center">
                                <Ellipse x:Name="SwitchThumb" Width="14" Height="14" Margin="3"
                                         Fill="White" HorizontalAlignment="Left" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Background="#EAF0F3" CornerRadius="7" Padding="4">
                                <TabPanel IsItemsHost="True" Background="Transparent" />
                            </Border>
                            <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1"
                                              Margin="0,18,0,0"
                                              ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="15,0" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabSurface" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="{StaticResource SkySoftBrush}" />
                                <Setter Property="Foreground" Value="#246B9D" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="White" />
                                <Setter Property="Foreground" Value="#2F5FC4" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource MutedSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="3" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ListItemSurface" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ListItemSurface" Property="Background" Value="{StaticResource SkySoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ListItemSurface" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter Property="Foreground" Value="#2F5FC4" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,0,0,22" />
            <Setter Property="Margin" Value="0,0,0,22" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="218" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#30343B" Padding="12,18,12,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border BorderBrush="#484E58" BorderThickness="0,0,0,1" Padding="10,0,10,16">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="32" Height="32" CornerRadius="7" Background="{StaticResource CoralSoftBrush}">
                            <Path Data="{x:Static local:MaterialIconPaths.Steam}" Width="18" Height="18"
                                  Stretch="Uniform" Fill="{StaticResource CoralBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="VR Translator" Foreground="White" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="{loc:Loc Key=Brand.Subtitle}" Foreground="#B3BAC5" FontSize="10" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="1" Margin="0,16,0,0">
                    <Button x:Name="CaptureNavButton" Style="{StaticResource NavButtonStyle}" Tag="capture" Click="NavigateButton_Click">
                        <StackPanel Orientation="Horizontal"><Grid Width="28"><Path Data="{x:Static local:MaterialIconPaths.CogOutline}" Width="16" Height="16" Stretch="Uniform" Fill="{StaticResource NavigationIconBrush}" /></Grid><TextBlock Text="{loc:Loc Key=Nav.Capture}" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" /></StackPanel>
                    </Button>
                    <Button x:Name="ProviderNavButton" Style="{StaticResource NavButtonStyle}" Tag="providers" Click="NavigateButton_Click">
                        <StackPanel Orientation="Horizontal"><Grid Width="28"><Path Data="{x:Static local:MaterialIconPaths.CloudOutline}" Width="16" Height="16" Stretch="Uniform" Fill="{StaticResource NavigationIconBrush}" /></Grid><TextBlock Text="{loc:Loc Key=Nav.Providers}" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" /></StackPanel>
                    </Button>
                    <Button x:Name="PromptsNavButton" Style="{StaticResource NavButtonStyle}" Tag="prompts" Click="NavigateButton_Click">
                        <StackPanel Orientation="Horizontal"><Grid Width="28"><Path Data="{x:Static local:MaterialIconPaths.Translate}" Width="16" Height="16" Stretch="Uniform" Fill="{StaticResource NavigationIconBrush}" /></Grid><TextBlock Text="{loc:Loc Key=Nav.Prompts}" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" /></StackPanel>
                    </Button>
                    <Button x:Name="VoiceNavButton" Style="{StaticResource NavButtonStyle}" Tag="voice" Click="NavigateButton_Click">
                        <StackPanel Orientation="Horizontal"><Grid Width="28"><Path Data="{x:Static local:MaterialIconPaths.Microphone}" Width="16" Height="16" Stretch="Uniform" Fill="{StaticResource NavigationIconBrush}" /></Grid><TextBlock Text="{loc:Loc Key=Nav.Voice}" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" /></StackPanel>
                    </Button>
                    <Button x:Name="SubtitlesNavButton" Style="{StaticResource NavButtonStyle}" Tag="subtitles" Click="NavigateButton_Click">
                        <StackPanel Orientation="Horizontal"><Grid Width="28"><Path Data="{x:Static local:MaterialIconPaths.ClosedCaptionOutline}" Width="16" Height="16" Stretch="Uniform" Fill="{StaticResource ExperimentalNavigationIconBrush}" /></Grid><TextBlock Text="{loc:Loc Key=Nav.Subtitles}" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" /><Border Background="#704D42" CornerRadius="3" Margin="7,0,0,0" Padding="5,1"><TextBlock Text="{loc:Loc Key=Common.Experimental}" Foreground="#FFF2DE" FontSize="8" /></Border></StackPanel>
                    </Button>
                    <Button x:Name="AndroidMirrorNavButton" Style="{StaticResource NavButtonStyle}" Tag="android-mirror" Click="NavigateButton_Click">
                        <StackPanel Orientation="Horizontal"><Grid Width="28"><Path Data="{x:Static local:MaterialIconPaths.Cellphone}" Width="16" Height="16" Stretch="Uniform" Fill="{StaticResource ExperimentalNavigationIconBrush}" /></Grid><TextBlock Text="{loc:Loc Key=Nav.AndroidMirror}" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" /><Border Background="#704D42" CornerRadius="3" Margin="7,0,0,0" Padding="5,1"><TextBlock Text="{loc:Loc Key=Common.Experimental}" Foreground="#FFF2DE" FontSize="8" /></Border></StackPanel>
                    </Button>
                    <Button x:Name="DiagnosticsNavButton" Style="{StaticResource NavButtonStyle}" Tag="diagnostics" Click="NavigateButton_Click">
                        <StackPanel Orientation="Horizontal"><Grid Width="28"><Path Data="{x:Static local:MaterialIconPaths.ChartBoxOutline}" Width="16" Height="16" Stretch="Uniform" Fill="{StaticResource NavigationIconBrush}" /></Grid><TextBlock Text="{loc:Loc Key=Nav.Diagnostics}" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" /></StackPanel>
                    </Button>
                </StackPanel>

                <Border Grid.Row="2" BorderBrush="#484E58" BorderThickness="0,1,0,0" Padding="10,12,10,0">
                    <StackPanel>
                        <TextBlock x:Name="VersionText" Foreground="#B3BAC5" FontSize="10" />
                        <TextBlock Text="Native WPF" Foreground="#B3BAC5" FontSize="10" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="#F6F8FC">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitleText" Text="{loc:Loc Key=Page.Capture.Title}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="PageContextText" Text="{loc:Loc Key=Page.Capture.Context}" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,16,0">
                        <Ellipse x:Name="RuntimeDot" Width="8" Height="8" Fill="#9DA59F" Margin="0,0,7,0" />
                        <StackPanel>
                            <TextBlock x:Name="StateText" Text="IDLE" FontSize="10" FontWeight="SemiBold" />
                            <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedTextBrush}" FontSize="10" MaxWidth="300" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                        </StackPanel>
                    </StackPanel>
                    <Button x:Name="StartButton" Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" Width="112" Click="StartButton_Click" ToolTip="{loc:Loc Key=Action.StartStop.Tooltip}">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="StartButtonIcon" Data="{x:Static local:MaterialIconPaths.Play}" Width="15" Height="15" Stretch="Uniform" Fill="White" VerticalAlignment="Center" />
                            <TextBlock x:Name="StartButtonText" Text="{loc:Loc Key=Action.StartService}" Foreground="White" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Border x:Name="DownloadPanel" Grid.Row="1" Visibility="Collapsed" Background="{StaticResource AmberSoftBrush}" BorderBrush="#EBCB8D" BorderThickness="0,0,0,1" Padding="24,9">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="DownloadStatusText" Text="{loc:Loc Key=Download.Downloading}" FontSize="11" Foreground="#7A5313" />
                        <ProgressBar x:Name="DownloadProgressBar" Height="4" Margin="0,7,14,0" Minimum="0" Maximum="100" Foreground="{StaticResource AmberBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource ActionButtonStyle}" Width="34" Padding="0" Click="CancelDownloadButton_Click" ToolTip="{loc:Loc Key=Download.Cancel.Tooltip}">
                        <TextBlock Text="×" FontSize="18" />
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <ScrollViewer x:Name="CapturePage" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28,24" MaxWidth="820" HorizontalAlignment="Left">
                        <Border Style="{StaticResource SectionStyle}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Key=Capture.Section.Title}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,16" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{loc:Loc Key=Capture.Eye}" />
                                    <ComboBox x:Name="StereoCompositionComboBox" Grid.Column="1" SelectionChanged="LivePreference_Changed" ToolTip="{loc:Loc Key=Capture.Eye.Tooltip}">
                                        <ComboBoxItem Content="{loc:Loc Key=Capture.Eye.Left}" Tag="left-eye" />
                                        <ComboBoxItem Content="{loc:Loc Key=Capture.Eye.Right}" Tag="right-eye" />
                                    </ComboBox>
                                    <TextBlock Grid.Row="1" Style="{StaticResource FieldLabelStyle}" Text="{loc:Loc Key=Capture.Scroll}" Margin="0,12,0,0" />
                                    <CheckBox x:Name="InvertResultScrollCheckBox" Grid.Row="1" Grid.Column="1" Content="{loc:Loc Key=Capture.Scroll.Invert}" Margin="0,12,0,0" VerticalAlignment="Center" Checked="LivePreference_Changed" Unchecked="LivePreference_Changed" ToolTip="{loc:Loc Key=Capture.Scroll.Tooltip}" />
                                    <TextBlock Grid.Row="2" Style="{StaticResource FieldLabelStyle}" Text="{loc:Loc Key=Capture.PointerRay}" Margin="0,12,0,0" />
                                    <CheckBox x:Name="ShowPointerRayCheckBox" Grid.Row="2" Grid.Column="1" Content="{loc:Loc Key=Capture.PointerRay.Enable}" Margin="0,12,0,0" VerticalAlignment="Center" Checked="LivePreference_Changed" Unchecked="LivePreference_Changed" ToolTip="{loc:Loc Key=Capture.PointerRay.Tooltip}" />
                                    <TextBlock Grid.Row="3" Style="{StaticResource FieldLabelStyle}" Text="{loc:Loc Key=Capture.PointerSmoothing}" Margin="0,12,0,0" />
                                    <ComboBox x:Name="PointerSmoothingComboBox" Grid.Row="3" Grid.Column="1" Margin="0,12,0,0" SelectionChanged="LivePreference_Changed" ToolTip="{loc:Loc Key=Capture.PointerSmoothing.Tooltip}">
                                        <ComboBoxItem Content="{loc:Loc Key=Capture.PointerSmoothing.Off}" Tag="0" />
                                        <ComboBoxItem Content="{loc:Loc Key=Capture.PointerSmoothing.Light}" Tag="25" />
                                        <ComboBoxItem Content="{loc:Loc Key=Capture.PointerSmoothing.Balanced}" Tag="50" />
                                        <ComboBoxItem Content="{loc:Loc Key=Capture.PointerSmoothing.Strong}" Tag="75" />
                                        <ComboBoxItem Content="{loc:Loc Key=Capture.PointerSmoothing.Maximum}" Tag="100" />
                                    </ComboBox>
                                    <TextBlock Grid.Row="4" Style="{StaticResource FieldLabelStyle}" Text="{loc:Loc Key=Capture.UiLanguage}" Margin="0,12,0,0" />
                                    <ComboBox x:Name="UiLanguageComboBox" Grid.Row="4" Grid.Column="1" Margin="0,12,0,0" SelectionChanged="UiLanguageComboBox_SelectionChanged" ToolTip="{loc:Loc Key=Capture.UiLanguage.Tooltip}">
                                        <ComboBoxItem Content="{loc:Loc Key=Language.English}" Tag="en" />
                                        <ComboBoxItem Content="{loc:Loc Key=Language.Japanese}" Tag="ja" />
                                        <ComboBoxItem Content="{loc:Loc Key=Language.Chinese}" Tag="zh" />
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="TestSelectionButton" Style="{StaticResource ActionButtonStyle}" Click="TestSelectionButton_Click" IsEnabled="False" ToolTip="{loc:Loc Key=Action.SimulateStick.Tooltip}">
                                <StackPanel Orientation="Horizontal"><Path Data="{x:Static local:MaterialIconPaths.Send}" Width="15" Height="15" Stretch="Uniform" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" /><TextBlock Text="{loc:Loc Key=Action.SimulateStick}" Margin="7,0,0,0" /></StackPanel>
                            </Button>
                            <Button x:Name="BindingsButton" Style="{StaticResource ActionButtonStyle}" Margin="8,0,0,0" Click="BindingsButton_Click" IsEnabled="False" ToolTip="{loc:Loc Key=Action.Bindings.Tooltip}">
                                <StackPanel Orientation="Horizontal"><Path Data="{x:Static local:MaterialIconPaths.GamepadVariant}" Width="16" Height="16" Stretch="Uniform" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" /><TextBlock Text="{loc:Loc Key=Action.Bindings}" Margin="7,0,0,0" /></StackPanel>
                            </Button>
                            <Button x:Name="WpfOverlayButton" Style="{StaticResource ActionButtonStyle}" Margin="8,0,0,0" Click="WpfOverlayButton_Click" IsEnabled="False" ToolTip="{loc:Loc Key=Action.ShowManagerVr.Tooltip}">
                                <StackPanel Orientation="Horizontal"><Path Data="{x:Static local:MaterialIconPaths.Monitor}" Width="16" Height="16" Stretch="Uniform" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" /><TextBlock x:Name="WpfOverlayButtonText" Text="{loc:Loc Key=Action.ShowManagerVr}" Margin="7,0,0,0" /></StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="ProvidersPage" Visibility="Collapsed" Margin="0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Background="{StaticResource MutedSurfaceBrush}" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Key=Provider.List.Title}" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="{loc:Loc Key=Provider.List.Description}" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,3,0,12" />
                            </StackPanel>
                            <ListBox x:Name="ProviderListBox" Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="White" SelectionChanged="ProviderListBox_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <Border Grid.Column="1" Background="{StaticResource AccentBrush}" CornerRadius="4" Padding="6,2" Margin="8,0,0,0"
                                                    ToolTip="{loc:Loc Key=Provider.Active.Tooltip}">
                                                <Border.Visibility>
                                                    <MultiBinding Converter="{StaticResource ProviderActiveVisibilityConverter}">
                                                        <Binding Path="Id" />
                                                        <Binding RelativeSource="{RelativeSource AncestorType=ListBox}" Path="Tag" />
                                                    </MultiBinding>
                                                </Border.Visibility>
                                                <TextBlock Text="{loc:Loc Key=Provider.Activated}" Foreground="White" FontSize="9" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Grid Grid.Row="2" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Button x:Name="AddProviderButton" Style="{StaticResource ActionButtonStyle}" Click="AddProviderButton_Click">
                                    <StackPanel Orientation="Horizontal"><Path Data="{x:Static local:MaterialIconPaths.Plus}" Width="15" Height="15" Stretch="Uniform" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" /><TextBlock Text="{loc:Loc Key=Provider.Add}" Margin="6,0,0,0" /></StackPanel>
                                </Button>
                                <Button x:Name="DeleteProviderButton" Grid.Column="1" Style="{StaticResource ActionButtonStyle}" Width="34" Padding="0" Margin="8,0,0,0" Click="DeleteProviderButton_Click" ToolTip="{loc:Loc Key=Provider.Delete.Tooltip}">
                                    <Path Data="{x:Static local:MaterialIconPaths.DeleteOutline}" Width="15" Height="15" Stretch="Uniform" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                        <StackPanel x:Name="ProviderEditorPanel" Margin="28,24" MaxWidth="690" HorizontalAlignment="Stretch">
                            <Border Style="{StaticResource SectionStyle}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock x:Name="ProviderEditorTitleText" Text="{loc:Loc Key=Provider.Editor.Title}" FontSize="15" FontWeight="SemiBold" />
                                            <TextBlock x:Name="ProviderEditorDescriptionText" Text="{loc:Loc Key=Provider.Editor.Empty}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <CheckBox x:Name="ProviderActiveCheckBox" Grid.Column="1" Content="{loc:Loc Key=Provider.Enabled}"
                                                  Click="ProviderActiveCheckBox_Click" ToolTip="{loc:Loc Key=Provider.Activate.Tooltip}" />
                                    </Grid>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{loc:Loc Key=Provider.Name}" />
                                        <TextBox x:Name="ProviderNameTextBox" Grid.Column="1" TextChanged="ProviderNameTextBox_TextChanged" ToolTip="{loc:Loc Key=Provider.Name.Tooltip}" />
                                    </Grid>
                                    <Border x:Name="MockProviderPanel" Background="{StaticResource MutedSurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="14" Visibility="Collapsed">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Loc Key=Provider.Mock.Title}" FontWeight="SemiBold" />
                                            <TextBlock Text="{loc:Loc Key=Provider.Mock.Description}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <StackPanel x:Name="CompatibleProviderPanel">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Base URL" />
                                            <TextBox x:Name="BaseUrlTextBox" Grid.Column="1" ToolTip="{loc:Loc Key=Provider.BaseUrl.Tooltip}" TextChanged="ProviderField_TextChanged" />
                                            <TextBlock Grid.Row="1" Style="{StaticResource FieldLabelStyle}" Text="API Key" Margin="0,12,0,0" />
                                            <PasswordBox x:Name="ApiKeyPasswordBox" Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" ToolTip="{loc:Loc Key=Provider.ApiKey.Tooltip}" PasswordChanged="ProviderField_PasswordChanged" />
                                            <TextBlock Grid.Row="2" Style="{StaticResource FieldLabelStyle}" Text="{loc:Loc Key=Provider.Model}" Margin="0,12,0,0" />
                                            <Grid Grid.Row="2" Grid.Column="1" Margin="0,12,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <ComboBox x:Name="ProviderModelComboBox" IsEditable="True" IsTextSearchEnabled="False" IsSynchronizedWithCurrentItem="False" StaysOpenOnEdit="True" SelectionChanged="ProviderModelComboBox_SelectionChanged" ToolTip="{loc:Loc Key=Provider.Model.Tooltip}" />
                                                <Button x:Name="RefreshProviderButton" Grid.Column="1" Style="{StaticResource ActionButtonStyle}" Margin="8,0,0,0" Click="RefreshProviderButton_Click" ToolTip="{loc:Loc Key=Provider.Test.Tooltip}">
                                                    <StackPanel Orientation="Horizontal"><Path Data="{x:Static local:MaterialIconPaths.Refresh}" Width="15" Height="15" Stretch="Uniform" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" /><TextBlock Text="{loc:Loc Key=Provider.Test}" Margin="6,0,0,0" /></StackPanel>
                                                </Button>
                                            </Grid>
                                        </Grid>
                                        <TextBlock x:Name="ProviderConnectionText" Text="{loc:Loc Key=Provider.NotTested}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="160,10,0,0" />
                                    </StackPanel>
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{loc:Loc Key=Provider.MaxConcurrency}" />
                                        <ComboBox x:Name="ProviderConcurrencyComboBox" Grid.Column="1" SelectionChanged="ProviderConcurrencyComboBox_SelectionChanged" ToolTip="{loc:Loc Key=Provider.MaxConcurrency.Tooltip}">
                                            <ComboBoxItem Content="1" Tag="1" /><ComboBoxItem Content="2" Tag="2" /><ComboBoxItem Content="3" Tag="3" /><ComboBoxItem Content="4" Tag="4" />
                                            <ComboBoxItem Content="5" Tag="5" /><ComboBoxItem Content="6" Tag="6" /><ComboBoxItem Content="7" Tag="7" /><ComboBoxItem Content="8" Tag="8" />
                                            <ComboBoxItem Content="9" Tag="9" /><ComboBoxItem Content="10" Tag="10" /><ComboBoxItem Content="11" Tag="11" /><ComboBoxItem Content="12" Tag="12" />
                                            <ComboBoxItem Content="13" Tag="13" /><ComboBoxItem Content="14" Tag="14" /><ComboBoxItem Content="15" Tag="15" /><ComboBoxItem Content="16" Tag="16" />
                                        </ComboBox>
                                    </Grid>
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{loc:Loc Key=Provider.TargetLanguage}" />
                                        <ComboBox x:Name="TargetLanguageComboBox" Grid.Column="1" SelectionChanged="LivePreference_Changed" ToolTip="{loc:Loc Key=Provider.TargetLanguage.Tooltip}">
                                            <ComboBoxItem Content="{loc:Loc Key=Language.Chinese}" Tag="zh-CN" /><ComboBoxItem Content="{loc:Loc Key=Language.Japanese}" Tag="ja-JP" /><ComboBoxItem Content="{loc:Loc Key=Language.English}" Tag="en-US" />
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="PromptsPage" Visibility="Collapsed" Margin="28,24">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Text="{loc:Loc Key=Prompt.Title}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{loc:Loc Key=Prompt.Description}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" />
                            <TextBlock x:Name="PromptSaveStatusText" Text="{loc:Loc Key=Prompt.Loaded}" Foreground="#2F5FC4" FontSize="10" Margin="0,5,0,0" />
                        </StackPanel>
                        <Button x:Name="ResetCurrentPromptButton" Grid.Column="1" Style="{StaticResource ActionButtonStyle}" Click="ResetCurrentPromptButton_Click" ToolTip="{loc:Loc Key=Prompt.Reset.Tooltip}">
                            <StackPanel Orientation="Horizontal"><Path Data="{x:Static local:MaterialIconPaths.Refresh}" Width="15" Height="15" Stretch="Uniform" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" /><TextBlock Text="{loc:Loc Key=Prompt.Reset}" Margin="7,0,0,0" /></StackPanel>
                        </Button>
                    </Grid>

                    <TabControl x:Name="PromptTabControl" Grid.Row="1">
                        <TabItem Header="{loc:Loc Key=Prompt.Direct.Tab}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="18,16" MaxWidth="760" HorizontalAlignment="Left">
                                    <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Style="{StaticResource FieldLabelStyle}" Text="{loc:Loc Key=Prompt.Provider}" /><ComboBox x:Name="DirectPromptProviderComboBox" Grid.Column="1" DisplayMemberPath="DisplayName" SelectionChanged="PromptProviderComboBox_SelectionChanged" ToolTip="{loc:Loc Key=Prompt.Provider.Tooltip}" /></Grid>
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{loc:Loc Key=Prompt.System}" />
                                    <TextBlock Text="{loc:Loc Key=Prompt.Direct.SystemDescription}" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,4,0,7" />
                                    <TextBox x:Name="MarkdownSystemPromptTextBox" Style="{StaticResource PromptEditorStyle}" TextChanged="PromptEditor_TextChanged" ToolTip="{loc:Loc Key=Prompt.Direct.SystemTooltip}" />
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{loc:Loc Key=Prompt.Direct.Task}" Margin="0,16,0,0" />
                                    <TextBlock Text="{loc:Loc Key=Prompt.Direct.TaskDescription}" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,4,0,7" />
                                    <TextBox x:Name="MarkdownTranslationPromptTextBox" Style="{StaticResource PromptEditorStyle}" TextChanged="PromptEditor_TextChanged" ToolTip="{loc:Loc Key=Prompt.Direct.TaskTooltip}" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="{loc:Loc Key=Prompt.Layout.Tab}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="18,16" MaxWidth="760" HorizontalAlignment="Left">
                                    <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Style="{StaticResource FieldLabelStyle}" Text="{loc:Loc Key=Prompt.Provider}" /><ComboBox x:Name="LayoutPromptProviderComboBox" Grid.Column="1" DisplayMemberPath="DisplayName" SelectionChanged="PromptProviderComboBox_SelectionChanged" ToolTip="{loc:Loc Key=Prompt.Provider.Tooltip}" /></Grid>
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{loc:Loc Key=Prompt.System}" />
                                    <TextBlock Text="{loc:Loc Key=Prompt.Layout.SystemDescription}" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,4,0,7" />
                                    <TextBox x:Name="LayoutSystemPromptTextBox" Style="{StaticResource PromptEditorStyle}" TextChanged="PromptEditor_TextChanged" ToolTip="{loc:Loc Key=Prompt.Layout.SystemTooltip}" />
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{loc:Loc Key=Prompt.Layout.Task}" Margin="0,16,0,0" />
                                    <TextBlock Text="{loc:Loc Key=Prompt.Layout.TaskDescription}" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,4,0,7" />
                                    <TextBox x:Name="LayoutTranslationPromptTextBox" Style="{StaticResource PromptEditorStyle}" TextChanged="PromptEditor_TextChanged" ToolTip="{loc:Loc Key=Prompt.Layout.TaskTooltip}" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="{loc:Loc Key=Prompt.Custom.Tab}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="18,16" MaxWidth="760" HorizontalAlignment="Left">
                                    <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Style="{StaticResource FieldLabelStyle}" Text="{loc:Loc Key=Prompt.Provider}" /><ComboBox x:Name="CustomPromptProviderComboBox" Grid.Column="1" DisplayMemberPath="DisplayName" SelectionChanged="PromptProviderComboBox_SelectionChanged" ToolTip="{loc:Loc Key=Prompt.Provider.Tooltip}" /></Grid>
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{loc:Loc Key=Prompt.System}" />
                                    <TextBlock Text="{loc:Loc Key=Prompt.Custom.SystemDescription}" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,4,0,7" />
                                    <TextBox x:Name="CustomCommandSystemPromptTextBox" Style="{StaticResource PromptEditorStyle}" TextChanged="PromptEditor_TextChanged" ToolTip="{loc:Loc Key=Prompt.Custom.SystemTooltip}" />
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{loc:Loc Key=Prompt.Custom.Task}" Margin="0,16,0,0" />
                                    <TextBlock Text="{loc:Loc Key=Prompt.Custom.TaskDescription}" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,4,0,7" />
                                    <TextBox x:Name="CustomCommandPromptTextBox" Style="{StaticResource PromptEditorStyle}" TextChanged="PromptEditor_TextChanged" ToolTip="{loc:Loc Key=Prompt.Custom.TaskTooltip}" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="{loc:Loc Key=Prompt.Voice.Tab}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="18,16" MaxWidth="760" HorizontalAlignment="Left">
                                    <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Style="{StaticResource FieldLabelStyle}" Text="{loc:Loc Key=Prompt.Provider}" /><ComboBox x:Name="VoicePromptProviderComboBox" Grid.Column="1" DisplayMemberPath="DisplayName" SelectionChanged="PromptProviderComboBox_SelectionChanged" ToolTip="{loc:Loc Key=Prompt.Provider.Tooltip}" /></Grid>
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{loc:Loc Key=Prompt.System}" />
                                    <TextBlock Text="{loc:Loc Key=Prompt.Voice.SystemDescription}" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,4,0,7" TextWrapping="Wrap" />
                                    <TextBox x:Name="VoiceTranslationSystemPromptTextBox" Style="{StaticResource PromptEditorStyle}" TextChanged="PromptEditor_TextChanged" ToolTip="{loc:Loc Key=Prompt.Voice.SystemTooltip}" />
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{loc:Loc Key=Prompt.Voice.Task}" Margin="0,16,0,0" />
                                    <TextBlock Text="{loc:Loc Key=Prompt.Voice.TaskDescription}" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,4,0,7" TextWrapping="Wrap" />
                                    <TextBox x:Name="VoiceTranslationPromptTextBox" Style="{StaticResource PromptEditorStyle}" TextChanged="PromptEditor_TextChanged" ToolTip="{loc:Loc Key=Prompt.Voice.TaskTooltip}" />
                                </StackPanel>
