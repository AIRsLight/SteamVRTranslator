<Window x:Class="SteamVRTranslator.VibeVoice.Manager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SteamVRTranslator.VibeVoice.Manager"
        Title="{local:Loc Key=App.Title}"
        Width="980"
        Height="700"
        MinWidth="880"
        MinHeight="620"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <Border Width="44" Height="44" HorizontalAlignment="Left"
                            CornerRadius="8" Background="#3A8AF5">
                        <Viewbox Margin="10">
                            <Path Fill="White"
                                  Data="M12,3C7.03,3 3,6.58 3,11C3,13.4 4.22,15.55 6.14,17.02L5.5,21L9.12,18.84C10.03,19.1 11,19.25 12,19.25C16.97,19.25 21,15.67 21,11.25C21,6.58 16.97,3 12,3M8.5,9.25A1.25,1.25 0 1,1 8.5,11.75A1.25,1.25 0 1,1 8.5,9.25M15.5,9.25A1.25,1.25 0 1,1 15.5,11.75A1.25,1.25 0 1,1 15.5,9.25M8,14H16C15.2,15.25 13.75,16 12,16C10.25,16 8.8,15.25 8,14Z" />
                        </Viewbox>
                    </Border>
                    <TextBlock Text="{local:Loc Key=App.Title}" Foreground="White"
                               FontSize="18" FontWeight="SemiBold" Margin="0,14,0,5" />
                    <TextBlock Text="{local:Loc Key=App.Subtitle}" Foreground="#AAB8CD"
                               FontSize="12" LineHeight="18" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,34,0,0">
                    <TextBlock Text="{local:Loc Key=Sidebar.Endpoint}" Foreground="#8495AE"
                               FontSize="10" FontWeight="SemiBold" />
                    <TextBlock x:Name="EndpointText" Foreground="#E6EDF8" FontSize="12"
                               Margin="0,7,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Row="3">
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,0,8" Click="OpenWebButton_Click"
                            Content="{local:Loc Key=Sidebar.OpenWeb}" />
                    <Button x:Name="OpenDataButton"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,0,8" Click="OpenDataButton_Click"
                            Content="{local:Loc Key=Sidebar.OpenData}" />
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Click="RefreshButton_Click"
                            Content="{local:Loc Key=Sidebar.Refresh}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="76" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="White" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="30,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{local:Loc Key=App.Title}" FontSize="20"
                                   FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Ellipse x:Name="ServiceStatusDot" Width="8" Height="8"
                                     Fill="#95A0B2" VerticalAlignment="Center" />
                            <TextBlock x:Name="ServiceStatusText" Margin="8,0,0,0"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="{local:Loc Key=Status.Connecting}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="StartButton" Style="{StaticResource PrimaryButtonStyle}"
                                MinWidth="128" Margin="0,0,10,0" Click="StartButton_Click"
                                Content="{local:Loc Key=Actions.Start}" />
                        <Button x:Name="StopButton" Style="{StaticResource SecondaryButtonStyle}"
                                MinWidth="128" Click="StopButton_Click"
                                Content="{local:Loc Key=Actions.Stop}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="DownloadProgressPanel" Grid.Row="1" Background="#EAF2FF"
                    BorderBrush="#C8DBF8" BorderThickness="0,0,0,1"
                    Visibility="Collapsed">
                <Grid Margin="30,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="DownloadProgressText" FontWeight="SemiBold"
                                   Text="{local:Loc Key=Progress.Preparing}" />
                        <ProgressBar x:Name="DownloadProgressBar" Height="7" Margin="0,9,18,0"
                                     Minimum="0" Maximum="1" Value="0" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource DangerButtonStyle}"
                            Click="CancelInstallButton_Click"
                            Content="{local:Loc Key=Actions.Cancel}" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="30,24,30,30">
                    <Border Background="White" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="7" Padding="22">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleStyle}"
                                       Text="{local:Loc Key=Settings.Title}" />
                            <TextBlock Style="{StaticResource MutedTextStyle}"
                                       Text="{local:Loc Key=Settings.Description}" />
                            <Grid Margin="0,20,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                                               Text="{local:Loc Key=Settings.Backend}" />
                                    <ComboBox x:Name="BackendComboBox" SelectionChanged="SettingControl_Changed">
                                        <ComboBoxItem Tag="cpu" Content="CPU" />
                                        <ComboBoxItem Tag="vulkan" Content="Vulkan" />
                                        <ComboBoxItem Tag="cuda" Content="CUDA" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                                               Text="{local:Loc Key=Settings.Device}" />
                                    <TextBox x:Name="DeviceIndexTextBox" Text="0"
                                             TextChanged="SettingControl_Changed" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                                               Text="{local:Loc Key=Settings.Threads}" />
                                    <TextBox x:Name="ThreadCountTextBox" Text="4"
                                             TextChanged="SettingControl_Changed" />
                                </StackPanel>
                                <StackPanel Grid.Column="6">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                                               Text="{local:Loc Key=Settings.Source}" />
                                    <ComboBox x:Name="DownloadSourceComboBox" SelectionChanged="SettingControl_Changed">
                                        <ComboBoxItem Tag="official" Content="{local:Loc Key=Settings.Official}" />
                                        <ComboBoxItem Tag="hf-mirror" Content="{local:Loc Key=Settings.Mirror}" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            <Button x:Name="ApplySettingsButton"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    HorizontalAlignment="Right" Margin="0,18,0,0"
                                    Click="ApplySettingsButton_Click"
                                    Content="{local:Loc Key=Settings.Apply}" />
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="7" Padding="22">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitleStyle}"
                                               Text="{local:Loc Key=Runtime.Title}" />
                                    <TextBlock Style="{StaticResource MutedTextStyle}"
                                               Text="{local:Loc Key=Runtime.Description}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,24,0,24">
                                    <Ellipse x:Name="RuntimeStatusDot" Width="10" Height="10"
                                             Fill="#95A0B2" VerticalAlignment="Center" />
                                    <TextBlock x:Name="RuntimeStatusText" Margin="9,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <Button x:Name="InstallRuntimeButton" Grid.Row="2"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        HorizontalAlignment="Left" MinWidth="140"
                                        Click="InstallRuntimeButton_Click"
                                        Content="{local:Loc Key=Runtime.Download}" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="7" Padding="22">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitleStyle}"
                                               Text="{local:Loc Key=Model.Title}" />
                                    <TextBlock Style="{StaticResource MutedTextStyle}"
                                               Text="{local:Loc Key=Model.Description}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,24,0,24">
                                    <Ellipse x:Name="ModelStatusDot" Width="10" Height="10"
                                             Fill="#95A0B2" VerticalAlignment="Center" />
                                    <TextBlock x:Name="ModelStatusText" Margin="9,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <Button x:Name="InstallModelButton" Grid.Row="2"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        HorizontalAlignment="Left" MinWidth="140"
                                        Click="InstallModelButton_Click"
                                        Content="{local:Loc Key=Model.Download}" />
                            </Grid>
                        </Border>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button x:Name="InstallAllButton" Style="{StaticResource PrimaryButtonStyle}"
                                MinWidth="126" Margin="0,0,10,0" Click="InstallAllButton_Click"
                                Content="{local:Loc Key=Actions.InstallAll}" />
                        <TextBlock x:Name="RuntimePathText" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Border x:Name="ErrorPanel" Margin="0,18,0,0" Padding="14"
                            Background="#FFF1F2" BorderBrush="#F2C8CD"
                            BorderThickness="1" CornerRadius="6" Visibility="Collapsed">
                        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
